{
  "manifest_version": 3,
  "name": "Capture the Domain",
  "version": "1.0",
  "description": "Turns pages you navigate to in an armed host into self-contained Markdown snapshots and uploads them to your read-later endpoint.",
  "permissions": ["storage", "tabs", "unlimitedStorage"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["shared.js", "content.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "action": {
    "default_title": "Capture the Domain",
    "default_popup": "popup.html"
  },
  "browser_specific_settings": {
    "safari": {
      "strict_min_version": "17.0"
    }
  }
}
