Screen {
    background: #070b10;
    color: #c9d1d9;
}

#main {
    height: 1fr;
    width: 100%;
}

#center {
    width: 1fr;
    height: 1fr;
    background: #0b1016;
}

#content {
    height: 1fr;
    width: 100%;
    background: #0b1016;
}

TerminalArea {
    width: 100%;
    height: 100%;
}

WelcomePane {
    position: absolute;
    width: 100%;
    height: 100%;
    background: #0b1016;
}

/* Textual's built-in toast/notification look, tuned to the palette. */
Toast {
    background: #161b22;
    color: #e6edf3;
    border: round #30363d;
}

Toast.-information {
    border: round #58a6ff;
}

Toast.-warning {
    border: round #d29922;
}

Toast.-error {
    border: round #f85149;
}

Button {
    border: none;
}

Footer {
    display: none;
}
